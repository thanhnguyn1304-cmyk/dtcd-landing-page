"use strict";(self.__LOADABLE_LOADED_CHUNKS__=self.__LOADABLE_LOADED_CHUNKS__||[]).push([[928],{16697:(e,t,a)=>{var i=a(64836).default;Object.defineProperty(t,"__esModule",{value:!0}),t.moreToolsCMSContent=t.default=void 0;var n=i(a(67294)),o=i(a(51117)),l=a(40710),r=a(16176),d=a(38978);t.moreToolsCMSContent={title:"More Tools",tools:[{id:"sharpen-image",title:"Sharpen Image",description:"Enhance edge definition to make photos look crisp and focused",image:"https://cdn.pixelbin.io/v2/dummy-cloudname/original/upscalemedia_assets/Enhance_With_AI/enhance_1.png",prompt:"Enhance the uploaded image by increasing brightness and overall clarity while preserving natural colors, skin tones, and original details. Improve lighting balance, reduce dullness and shadows, and bring out hidden details without overexposing highlights or washing out the image. Ensure the final output looks realistic, sharp, and high-quality, with no color distortion, noise, or artificial effects, while maintaining the original structure and texture of the photo."},{id:"retouch-photo",title:"Retouch Photo",description:"Polish textures and details for a smooth, refined finish",image:"https://cdn.pixelbin.io/v2/dummy-cloudname/original/upscalemedia_assets/Enhance_With_AI/enhance_2.png",prompt:"Remove dust from the uploaded image and restore natural clarity. Unblur all blurred areas including text, face, body, objects, or background if present. Enhance sharpness, focus, and readability while preserving original identity, proportions, and details. If text is present, make it clearly readable without altering content. If a face or human body is present, restore clarity naturally without changing facial features or appearance. Maintain realistic textures, lighting, colors, and overall authenticity. Avoid over-sharpening, artificial details, hallucinated content, or visual distortion"},{id:"enhance-face",title:"Enhance Face",description:"Revive portraits by brightening and smoothing facial features",image:"https://cdn.pixelbin.io/v2/dummy-cloudname/original/upscalemedia_assets/Enhance_With_AI/enhance_3.png",prompt:"Restore image clarity by removing blur, distortion, and noise. Reconstruct lost details, sharpen edges, and enhance fine textures. If the image is heavily blurred or distorted, correct it to a clear and natural appearance. Upscale resolution without preserving blur or unwanted visual effects. Maintain original colors, lighting, and realistic structure. Avoid artifacts, over-sharpening, or artificial enhancements"},{id:"deblur-image",title:"Deblur Image",description:"Eliminate blur to bring back natural sharpness",image:"https://cdn.pixelbin.io/v2/dummy-cloudname/original/upscalemedia_assets/Enhance_With_AI/enhance_4.png",prompt:"Remove blur from the uploaded image and restore natural clarity. Unblur all blurred areas including text, face, body, objects, or background if present. Enhance sharpness, focus, and readability while preserving original identity, proportions, and details. If text is present, make it clearly readable without altering content. If a face or human body is present, restore clarity naturally without changing facial features or appearance. Maintain realistic textures, lighting, colors, and overall authenticity. Avoid over-sharpening, artificial details, hallucinated content, or visual distortion"},{id:"dehaze-image",title:"Dehaze Image",description:"Remove haze and improve contrast for clearer, vivid visuals",image:"https://cdn.pixelbin.io/v2/dummy-cloudname/original/upscalemedia_assets/Enhance_With_AI/enhance_5.png",prompt:"Remove haze and fog from the uploaded image. Improve clarity, contrast, and visibility while preserving natural colors, lighting, and details. Maintain a realistic and clean look without over-processing."},{id:"remove-motion-blur",title:"Remove Motion Blur",description:"Correct camera shake for a steady, well-defined image",image:"https://cdn.pixelbin.io/v2/dummy-cloudname/original/upscalemedia_assets/Enhance_With_AI/enhance_6.png",prompt:"Remove motion blur from the uploaded image. Restore sharpness and clarity while preserving original colors, textures, and details. Maintain a natural look without over-sharpening or artifacts. High-quality realistic result."},{id:"restore-image",title:"Restore Image",description:"Repair aged or damaged photos and recover lost details",image:"https://cdn.pixelbin.io/v2/dummy-cloudname/original/upscalemedia_assets/Enhance_With_AI/enhance_7.png",prompt:"Restore the uploaded image by repairing damage, improving clarity, and enhancing details. Remove noise, scratches, blur, and compression artifacts. Preserve original colors, textures, and composition. Produce a clean, natural, high-quality restored image."},{id:"colourise-image",title:"Colourise Image",description:"Add realistic colours to black-and-white or faded photos",image:"https://cdn.pixelbin.io/v2/dummy-cloudname/original/upscalemedia_assets/Enhance_With_AI/enhance_8.png",prompt:"Colorize the uploaded black and white image with natural and realistic colors. Preserve original details, textures, and lighting. Apply accurate skin tones, clothing colors, and background colors. Maintain a clean, realistic, high-quality photo look."},{id:"face-restoration",title:"Face Restoration",description:"Rebuild facial features with enhanced sharpness and tone",image:"https://cdn.pixelbin.io/v2/dummy-cloudname/original/upscalemedia_assets/Enhance_With_AI/enhance_9.png",prompt:"Restore the face in the uploaded image with ultra high-quality enhancement. Strong identity preservation, realistic skin texture, clear eyes, reduced blur and noise, professional portrait-quality result."}]};const s=o.default.section.withConfig({displayName:"MoreTools__Section",componentId:"sc-lrsggk-0"})(["width:100%;background:transparent;padding:64px 0 80px;margin-top:16px;@media (max-width:","px){margin-top:80px;padding:48px 0 64px;}@media (max-width:","px){margin-top:48px;padding:40px 0 56px;}"],r.Breakpoints.tablet,r.Breakpoints.